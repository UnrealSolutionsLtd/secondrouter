# --- required ---
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_API_KEY=your-byteplus-modelark-key
ROUTER_KEYS=test-key-123

# --- optional ---
# Absolute URL clients use to reach this service (used to build polling_url).
# Leave blank locally to auto-derive from the request; SET THIS in cloud to your
# public https URL so polling_url is correct behind a load balancer.
PUBLIC_BASE_URL=

# --- prompt optimization (opt-in per request, off by default) ---
# Rewrites `prompt` with an LLM before generation, using the vendor prompt guides
# in optimizer/skills/. A request opts in with "optimize_prompt": true.
# OPTIMIZER_DEFAULT=off              # flip to `on` to optimize unless told not to
# OPTIMIZER_MODEL=seed-2-0-pro-260328
# OPTIMIZER_BASE_URL=                # defaults to ARK_BASE_URL
# OPTIMIZER_API_KEY=                 # defaults to ARK_API_KEY
# OPTIMIZER_TIMEOUT=120              # seconds; failure falls back to the raw prompt
# OPTIMIZER_MAX_TOKENS=2048
